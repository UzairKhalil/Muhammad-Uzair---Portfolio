---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
---

<BaseLayout title="Page not found — Muhammad Uzair" noindex>
  <section class="notfound container" aria-labelledby="nf-title">
    <p class="eyebrow">Error 404</p>
    <h1 id="nf-title">This endpoint <span class="serif">returned nothing.</span></h1>
    <p>The page you're looking for doesn't exist or has moved.</p>
    <Button href="/" icon="arrowRight">Back to home</Button>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: grid;
    justify-items: start;
    gap: 22px;
    padding-block: clamp(80px, 16vw, 180px);
  }

  h1 {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
  }

  h1 .serif {
    color: var(--accent);
  }

  p:not(.eyebrow) {
    color: var(--muted);
    font-size: 1.1rem;
  }
</style>
