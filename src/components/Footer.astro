---
import { navigation, site } from '@/data/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <p class="footer__name">{site.name}</p>
      <p class="footer__role">{site.role} · {site.location}</p>
    </div>

    <nav aria-label="Footer">
      <ul class="footer__nav">
        {
          navigation.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="footer__social">
      <li>
        <a href={`mailto:${site.email}`} aria-label="Email"><Icon name="mail" size={18} /></a>
      </li>
      <li>
        <a href={site.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in a new tab)">
          <Icon name="github" size={18} />
        </a>
      </li>
      <li>
        <a
          href={site.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn (opens in a new tab)"
        >
          <Icon name="linkedin" size={18} />
        </a>
      </li>
    </ul>
  </div>
  <div class="container footer__bottom">
    <p>© {year} {site.name}. All rights reserved.</p>
    <a href="#top" class="footer__top">Back to top ↑</a>
  </div>
</footer>

<style>
  .footer {
    padding-top: 56px;
    border-top: 1px solid var(--line);
    font-size: 0.94rem;
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding-bottom: 36px;
  }

  .footer__name {
    font-weight: 600;
    font-size: 1.05rem;
  }

  .footer__role {
    color: var(--muted);
  }

  .footer__nav,
  .footer__social {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
  }

  .footer__nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .footer__nav a:hover {
    color: var(--ink);
  }

  .footer__social {
    gap: 8px;
  }

  .footer__social a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 50%;
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .footer__social a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    position: relative;
    padding-block: 22px 32px;
    color: var(--muted);
    font-size: 0.86rem;
  }

  .footer__bottom::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--gutter);
    right: var(--gutter);
    border-top: 1px solid var(--line);
  }

  .footer__top {
    color: var(--muted);
    text-decoration: none;
  }

  .footer__top:hover {
    color: var(--ink);
  }
</style>
