---
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
import { education, experience, languages } from '@/data/experience';

const facts = [
  { icon: 'mapPin', label: 'Based in', value: site.location },
  { icon: 'clock', label: 'Timezone', value: site.timezone },
  { icon: 'server', label: 'Focus', value: 'Backend & integrations' },
] as const;
---

<Section id="about">
  <SectionHeading id="about-title" eyebrow="About" title="Reliable integrations are">
    <Fragment slot="emphasis">mostly careful engineering.</Fragment>
  </SectionHeading>

  <div class="about">
    <div class="about__intro" data-reveal>
      <p class="about__lead">{site.intro}</p>
      <p>
        Most of my work sits where products meet other people's APIs: stores pushing orders in, carriers returning
        rates and labels, marketplaces changing prices and stock. I care about the unglamorous parts — rate limits,
        retries, idempotent webhooks, indexes and queues — because that's what keeps these systems running at
        volume.
      </p>

      <ul class="facts">
        {
          facts.map((f) => (
            <li>
              <Icon name={f.icon} size={18} />
              <span class="facts__label">{f.label}</span>
              <span class="facts__value">{f.value}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="about__timeline">
      <h3 class="about__subhead" data-reveal>Experience</h3>
      <ol class="timeline">
        {
          experience.map((role, i) => (
            <li class="timeline__item" data-reveal style={`--reveal-delay:${i}`}>
              <div class="timeline__head">
                <h4>
                  {role.title} <span class="timeline__company">· {role.company}</span>
                </h4>
                <p class="timeline__period mono">{role.period}</p>
              </div>
              <p class="timeline__context">
                {role.location} — {role.context}
              </p>
              <ul class="timeline__list">
                {role.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>

      <div class="about__extras" data-reveal>
        <div>
          <h3 class="about__subhead">Education</h3>
          <p class="extra__title">{education.degree}</p>
          <p class="extra__meta">
            {education.school} · <span class="mono">{education.period}</span>
          </p>
          <p class="extra__note">{education.note}</p>
        </div>
        <div>
          <h3 class="about__subhead">Languages</h3>
          <ul class="langs">
            {
              languages.map((l) => (
                <li>
                  <span>{l.name}</span>
                  <span class="extra__meta">{l.level}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  .about {
    display: grid;
    gap: clamp(48px, 6vw, 88px);
  }

  @media (min-width: 960px) {
    .about {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: start;
    }

    .about__intro {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
  }

  .about__intro {
    display: grid;
    gap: 20px;
    color: var(--muted);
  }

  .about__lead {
    color: var(--ink);
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    line-height: 1.55;
    letter-spacing: -0.01em;
  }

  .facts {
    list-style: none;
    display: grid;
    margin-top: 12px;
    border-top: 1px solid var(--line);
  }

  .facts li {
    display: grid;
    grid-template-columns: 18px 100px 1fr;
    gap: 12px;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }

  .facts :global(.icon) {
    color: var(--accent);
  }

  .facts__value {
    color: var(--ink);
    font-weight: 500;
  }

  .about__subhead {
    margin-bottom: 20px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .timeline__item {
    position: relative;
    padding: 28px clamp(20px, 3vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
  }

  .timeline__item::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 32px;
    width: 3px;
    height: 26px;
    border-radius: 0 3px 3px 0;
    background: var(--accent);
  }

  .timeline__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 16px;
  }

  h4 {
    font-size: 1.15rem;
    letter-spacing: -0.015em;
  }

  .timeline__company {
    color: var(--accent);
    font-weight: 500;
  }

  .timeline__period {
    color: var(--muted);
    font-size: 0.82rem;
    white-space: nowrap;
  }

  .timeline__context {
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.94rem;
  }

  .timeline__list {
    display: grid;
    gap: 8px;
    margin-top: 18px;
    padding-left: 18px;
    font-size: 0.96rem;
    color: var(--ink-soft);
  }

  .timeline__list li::marker {
    color: var(--accent);
  }

  .about__extras {
    display: grid;
    gap: 32px;
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 640px) {
    .about__extras {
      grid-template-columns: 1fr 1fr;
    }
  }

  .extra__title {
    font-weight: 600;
  }

  .extra__meta {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .extra__note {
    margin-top: 8px;
    color: var(--ink-soft);
    font-size: 0.94rem;
    font-style: italic;
  }

  .langs {
    list-style: none;
    display: grid;
    gap: 10px;
  }

  .langs li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 10px;
    border-bottom: 1px dashed var(--line);
  }
</style>
