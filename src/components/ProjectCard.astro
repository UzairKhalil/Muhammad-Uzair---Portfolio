---
import { Image } from 'astro:assets';
import type { Project } from '@/data/projects';
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';
import Tag from './Tag.astro';

interface Props {
  project: Project;
  index: number;
  layout?: 'feature' | 'compact';
}

const { project, index, layout = 'compact' } = Astro.props;
const number = String(index + 1).padStart(2, '0');
const headingId = `project-${project.slug}`;
---

<article class:list={['project', `project--${layout}`]} aria-labelledby={headingId} data-reveal>
  {
    layout === 'feature' && (
      <div class="project__media">
        {project.image ? (
          <Image
            src={project.image}
            alt={project.imageAlt ?? `${project.title} screenshot`}
            widths={[480, 800, 1200]}
            sizes="(min-width: 960px) 560px, 100vw"
            class="project__img"
          />
        ) : (
          <Placeholder
            label={`${project.title} screenshot`}
            hint={`src/assets/projects/${project.slug}.png`}
          />
        )}
      </div>
    )
  }

  <div class="project__body">
    <div class="project__meta">
      <span class="project__num mono" aria-hidden="true">{number}</span>
      {project.period && <span class="project__period">{project.period}</span>}
    </div>

    <h3 id={headingId}>{project.title}</h3>
    <p class="project__kind">{project.kind}</p>
    <p class="project__summary">{project.summary}</p>

    <div class="project__block">
      <h4 class="project__label">What I built</h4>
      <ul class="project__list">
        {
          project.contributions.map((item) => (
            <li>
              <Icon name="check" size={16} />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    {
      project.outcome && (
        <div class="project__block">
          <h4 class="project__label">Outcome</h4>
          <p>{project.outcome}</p>
        </div>
      )
    }

    <div class="project__footer">
      <ul class="project__stack" aria-label="Technologies">
        {
          project.stack.map((tech) => (
            <li>
              <Tag>{tech}</Tag>
            </li>
          ))
        }
      </ul>

      {
        project.links?.map((link) => (
          <a class="project__link" href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
            <Icon name="arrowUpRight" size={16} />
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        ))
      }
    </div>
  </div>
</article>

<style>
  .project {
    position: relative;
    display: grid;
    gap: 28px;
    padding: clamp(20px, 3vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    box-shadow: var(--shadow);
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      transform 0.3s var(--ease);
  }

  .project:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-lg);
  }

  @media (min-width: 960px) {
    .project--feature {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 48px;
      align-items: center;
    }
  }

  .project__media {
    min-width: 0;
  }

  .project__img {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }

  .project__body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .project__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--muted);
    font-size: 0.86rem;
  }

  .project__num {
    color: var(--accent);
    font-size: 0.8rem;
  }

  h3 {
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
  }

  .project--compact h3 {
    font-size: 1.35rem;
  }

  .project__kind {
    margin-top: -6px;
    color: var(--accent);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.15rem;
  }

  .project__summary {
    color: var(--ink-soft);
  }

  .project__block {
    display: grid;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }

  .project__label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .project__list {
    list-style: none;
    display: grid;
    gap: 8px;
    font-size: 0.96rem;
  }

  .project__list li {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 10px;
    align-items: start;
  }

  .project__list :global(.icon) {
    margin-top: 5px;
    color: var(--accent);
  }

  .project__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: auto;
    padding-top: 6px;
  }

  .project__stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .project__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
    font-size: 0.94rem;
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 2px;
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .project__link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
