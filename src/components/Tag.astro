---
interface Props {
  variant?: 'default' | 'accent';
}

const { variant = 'default' } = Astro.props;
---

<span class:list={['tag', `tag--${variant}`]}><slot /></span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 5px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.2;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .tag--accent {
    border-color: transparent;
    background: var(--accent-soft);
    color: var(--accent);
  }
</style>
