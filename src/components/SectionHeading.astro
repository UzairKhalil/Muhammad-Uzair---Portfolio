---
interface Props {
  id: string;
  eyebrow: string;
  /** Plain title text. Use the "emphasis" slot for an italic serif accent. */
  title: string;
  lead?: string;
  align?: 'start' | 'center';
}

const { id, eyebrow, title, lead, align = 'start' } = Astro.props;
---

<header class:list={['heading', `heading--${align}`]} data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id}>
    {title}
    {Astro.slots.has('emphasis') && (
      <>
        {' '}
        <span class="serif">
          <slot name="emphasis" />
        </span>
      </>
    )}
  </h2>
  {lead && <p class="lead">{lead}</p>}
</header>

<style>
  .heading {
    display: grid;
    gap: 18px;
    max-width: 720px;
    margin-bottom: clamp(40px, 6vw, 64px);
  }

  .heading--center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }

  h2 {
    font-size: clamp(2rem, 4.6vw, 3.25rem);
  }

  h2 .serif {
    color: var(--accent);
  }

  .lead {
    color: var(--muted);
    font-size: clamp(1.02rem, 1.4vw, 1.14rem);
    max-width: 60ch;
  }
</style>
